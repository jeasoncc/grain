{
  "name": "@grain/editor-monaco",
  "version": "0.1.0",
  "description": "Grain Monaco Editor - Code and diagram editing based on Monaco Editor",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./document": {
      "import": "./src/document/index.ts",
      "types": "./src/document/index.ts"
    },
    "./code": {
      "import": "./src/code/index.ts",
      "types": "./src/code/index.ts"
    },
    "./diagram": {
      "import": "./src/diagram/index.ts",
      "types": "./src/diagram/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@grain/editor-core": "^0.1.0",
    "@monaco-editor/react": "^4.7.0",
    "react-resizable-panels": "^4.14.2",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-resizable-panels": "^4.14.2",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.3"
  }
}
