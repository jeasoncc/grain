{
  "name": "@grain/editor-lexical",
  "version": "0.1.0",
  "description": "Grain Lexical Editor - A rich text editor based on Lexical",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./document": {
      "import": "./src/document/index.ts",
      "types": "./src/document/index.ts"
    },
    "./code": {
      "import": "./src/code/index.ts",
      "types": "./src/code/index.ts"
    },
    "./diagram": {
      "import": "./src/diagram/index.ts",
      "types": "./src/diagram/index.ts"
    },
    "./styles.css": "./src/themes/PlaygroundEditorTheme.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "mermaid": "^12.1.0",
    "lucide-react": "^1.52.0",
    "prismjs": "1.30.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@grain/editor-core": "^0.1.0",
    "lexical": "0.52.0",
    "@lexical/react": "0.52.0",
    "@lexical/code": "0.52.0",
    "@lexical/hashtag": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/overflow": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/table": "0.52.0",
    "@lexical/code-prism": "0.52.0",
    "@lexical/extension": "0.52.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/prismjs": "1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
