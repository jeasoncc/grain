{
  "name": "@grain/eslint-plugin",
  "version": "2.0.0",
  "description": "ESLint plugin for Grain functional programming architecture enforcement",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/fix-imports.js",
