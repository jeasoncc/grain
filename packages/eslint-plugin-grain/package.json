    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
