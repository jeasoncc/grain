;;; org-default-syntax.gnu-data.el --- Installed-default primitive data -*- lexical-binding: t; -*-
;; Research/generation only. No user files, local variables, Babel, or matcher overrides.
(require 'json)
(require 'cl-lib)
(require 'org)

(defun grain-org-native-ranges (regexp table)
  (with-syntax-table table
    (let ((case-fold-search t) start end ranges)
      (dotimes (point #x110000)
        (if (string-match-p regexp (char-to-string point))
            (progn (unless start (setq start point)) (setq end point))
          (when start (push (vector start end) ranges) (setq start nil))))
      (when start (push (vector start end) ranges))
      (vconcat (nreverse ranges)))))

(defun grain-org-native-word-navigation ()
  "Capture installed script/category inputs to GNU word_boundary_p."
  (let (scripts categories)
    (map-char-table
     (lambda (range script)
       (let ((from (if (consp range) (car range) range))
             (to (if (consp range) (cdr range) range)))
         (when (and script (< from #x110000))
           (push (vector from (min to #x10ffff) (symbol-name script)) scripts))))
     char-script-table)
    (dolist (category (delete-dups
                       (delq nil (append (mapcar #'car word-combining-categories)
                                         (mapcar #'cdr word-combining-categories)
                                         (mapcar #'car word-separating-categories)
                                         (mapcar #'cdr word-separating-categories)))))
      (let (ranges)
        (map-char-table
         (lambda (range set)
           (let ((from (if (consp range) (car range) range))
                 (to (if (consp range) (cdr range) range)))
             (when (and set (aref set category) (< from #x110000))
               (setq to (min to #x10ffff))
               (if (and ranges (= from (1+ (aref (car ranges) 1))))
                   (aset (car ranges) 1 to)
                 (push (vector from to) ranges)))))
         (category-table))
        (push (cons (intern (number-to-string category))
                    (vconcat (nreverse ranges))) categories)))
    `((scripts . ,(vconcat (nreverse scripts)))
      (categories . ,(nreverse categories))
      (combining . ,(vconcat (mapcar (lambda (pair) (vector (or (car pair) :null) (or (cdr pair) :null)))
                                    word-combining-categories)))
      (separating . ,(vconcat (mapcar (lambda (pair) (vector (or (car pair) :null) (or (cdr pair) :null)))
                                     word-separating-categories))))))

(defun grain-org-native-regexp-atoms ()
  "Capture default syntax/category classes, not JavaScript Unicode properties."
  (with-temp-buffer
    (let ((org-inhibit-startup t) (enable-local-variables nil) (enable-local-eval nil))
      (org-mode))
    (let (syntax categories)
      (dolist (mode '(property tag))
        (with-syntax-table (if (eq mode 'tag) org-mode-tags-syntax-table (syntax-table))
          (let ((ranges (make-hash-table :test #'eql)))
            (dotimes (point #x110000)
              (let* ((code (char-syntax point)) (previous (gethash code ranges)))
                (if (and previous (= point (1+ (aref (car previous) 1))))
                    (aset (car previous) 1 point)
                  (puthash code (cons (vector point point) previous) ranges))))
            (let (entries)
              (dolist (code (string-to-list " .w_()'\"$\\/< >@!|"))
                (unless (assq (intern (char-to-string code)) entries)
                  (push (cons (intern (char-to-string code))
                              (vconcat (nreverse (gethash code ranges)))) entries)))
              (push (cons mode (nreverse entries)) syntax)))))
      (dotimes (offset 95)
        (let ((code (+ 32 offset)) ranges)
          (map-char-table
           (lambda (range set)
             (let ((from (if (consp range) (car range) range))
                   (to (if (consp range) (cdr range) range)))
               (when (and set (aref set code) (< from #x110000))
                 (setq to (min to #x10ffff))
                 (if (and ranges (= from (1+ (aref (car ranges) 1))))
                     (aset (car ranges) 1 to)
                   (push (vector from to) ranges)))))
           (category-table))
          (push (cons (intern (char-to-string code)) (vconcat (nreverse ranges))) categories)))
      `((emacsVersion . ,emacs-version) (orgVersion . ,(org-version))
        (syntax . ,(nreverse syntax)) (categories . ,(nreverse categories))))))

(when (member "--regexp-atoms" command-line-args-left)
  (princ (json-serialize (grain-org-native-regexp-atoms)))
  (kill-emacs 0))

(with-temp-buffer
  (let ((org-inhibit-startup t)
        (enable-local-variables nil)
        (enable-local-eval nil))
    (org-mode))
  (let* ((table (syntax-table))
         (classes '("alnum" "alpha" "ascii" "blank" "cntrl" "digit" "graph"
                    "lower" "upper" "print" "punct" "space" "xdigit"))
         (case-fold-search t)
         (navigation (grain-org-native-word-navigation))
         atoms folds)
    ;; Property regexps, source word selection, and object-prefix recognition
    ;; use the Org buffer table.  Object bracket-pair tables are only delimiters,
    ;; not a replacement Unicode word context; the tag table adds @ and _.
    (push (cons 'propertyWord (grain-org-native-ranges "\\w" table)) atoms)
    (push (cons 'tagWord (grain-org-native-ranges "\\w" org-mode-tags-syntax-table)) atoms)
    (dolist (class classes)
      (push (cons (intern class)
                  (grain-org-native-ranges (concat "[[:" class ":]]") table)) atoms))
    ;; Actual default case-table cycles, including overrides absent from JS Unicode folding.
    (string-match-p "a" "A")
    (let ((equivalents (char-table-extra-slot (current-case-table) 2))
          (seen (make-hash-table :test #'eql)))
      (dotimes (point #x110000)
        (when (and (not (gethash point seen)) (aref equivalents point))
          (let ((next point) group)
            (while (and next (not (gethash next seen)))
              (puthash next t seen)
              (push next group)
              (setq next (aref equivalents next)))
            (when (> (length group) 1)
              (push (vconcat (sort group #'<)) folds))))))
    (setq atoms (nreverse atoms) folds (nreverse folds))
    (if (member "--json" command-line-args-left)
        (progn
          (setq command-line-args-left (delete "--json" command-line-args-left))
          (princ (json-serialize
                  `((emacsVersion . ,emacs-version) (orgVersion . ,(org-version))
                    (atoms . ,atoms) (folds . ,(vconcat folds))
                    (wordNavigation . ,navigation)))))
      (cl-labels ((atom (ranges)
                   (concat "[" (mapconcat
                                (lambda (range)
                                  (concat (format "\\u{%x}" (aref range 0))
                                          (unless (= (aref range 0) (aref range 1))
                                            (format "-\\u{%x}" (aref range 1)))))
                                ranges "") "]")))
        (princ (format "// Generated by org-default-syntax.gnu-data.el from installed GNU Emacs %s / Org %s.\n" emacs-version (org-version)))
        (princ "// Default Org context only; no user syntax/case-table modifications are represented.\n")
        (princ "export const ORG_NATIVE_CHARACTER_ATOMS: Readonly<{\n")
        (dolist (entry atoms) (princ (format "\treadonly %s: string\n" (car entry))))
        (princ "}> = {\n")
        (dolist (entry atoms) (princ (format "\t%s: %s,\n" (car entry) (json-serialize (atom (cdr entry))))))
        (princ "}\n\nexport const ORG_NATIVE_CASE_FOLDS: Readonly<Record<number, string | undefined>> = {\n")
        (let (records)
          (dolist (group folds)
            (let ((value (atom (mapcar (lambda (point) (vector point point)) group))))
              (mapc (lambda (point) (push (cons point value) records)) group)))
          (dolist (entry (sort records (lambda (left right) (< (car left) (car right)))))
            (princ (format "\t%d: %s,\n" (car entry) (json-serialize (cdr entry))))))
        (princ "}\n\nexport const ORG_NATIVE_WORD_NAVIGATION: Readonly<{\n")
        (princ "\treadonly scripts: readonly (readonly [number, number, string])[]\n")
        (princ "\treadonly categories: Readonly<Record<number, readonly (readonly [number, number])[]>>\n")
        (princ "\treadonly combining: readonly (readonly [number | null, number | null])[]\n")
        (princ "\treadonly separating: readonly (readonly [number | null, number | null])[]\n")
        (princ (concat "}> = " (json-serialize navigation) "\n"))))))
