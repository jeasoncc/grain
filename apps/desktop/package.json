{
  "name": "desktop",
  "version": "0.1.606",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "build:test": "tsc && NODE_ENV=development vite build --mode development",
    "bundle-analyze": "npx vite-bundle-analyzer",
    "check": "biome check --write",
    "clean:all": "rm -rf node_modules dist .turbo && bun install",
    "complexity:report": "npx plato -r -d complexity-report src",
    "dead-code": "ts-unused-exports tsconfig.json",
    "deps:check": "npx depcheck",
    "deps:update": "npx npm-check-updates -u",
    "dev": "vite",
    "dev:api": "cargo run --manifest-path ../../apps/api-rust/Cargo.toml",
    "dev:full": "concurrently \"bun run dev:vite\" \"bun run type:check:watch\"",
    "dev:vite": "vite",
    "diff": "git diff --staged > diff.txt",
    "docs:generate": "npx typedoc --out docs src",
    "format": "biome format --write && biome check --write && sort-package-json package.json",
    "format:check": "biome format",
    "health:check": "bun run type:check && bun run lint && bun run test",
    "icon:generate": "tauri icon src-tauri/icons/my-new-icon.png",
    "icon:update": "bash ../../scripts/update-icons.sh",
    "lint": "eslint --config eslint.config.grain.js 'src/**/*.{ts,tsx}' --format json | node scripts/categorize-lint-report.js",
    "lint:files": "eslint --config eslint.config.grain.js",
    "lint:hooks": "eslint --config eslint.config.grain.js 'src/hooks/**/*.ts'",
    "lint:views": "eslint --config eslint.config.grain.js 'src/views/**/*.tsx'",
    "lint:pipes": "eslint --config eslint.config.grain.js 'src/pipes/**/*.ts'",
    "lint:flows": "eslint --config eslint.config.grain.js 'src/flows/**/*.ts'",
    "lint:io": "eslint --config eslint.config.grain.js 'src/io/**/*.ts'",
    "lint:grain:report": "eslint --config eslint.config.grain.js 'src/**/*.{ts,tsx}' --format json | node scripts/categorize-lint-report.js",
    "perf:analyze": "npx source-map-explorer 'dist/assets/*.js'",
    "preview": "vite preview",
    "security:audit": "bun audit",
    "tauri": "tauri",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type:check": "tsc --noEmit",
    "type:check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@replit/codemirror-vim": "6.4.0",
    "@replit/codemirror-vim-core": "0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/router-plugin": "^1.168.42",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "docx": "^9.8.1",
    "driver.js": "^1.9.0",
    "es-toolkit": "^1.52.0",
    "file-saver": "^2.0.5",
    "fp-ts": "^2.16.11",
    "immer": "^11.1.21",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "lunr": "^2.3.9",
    "mermaid": "^12.1.0",
    "million": "^3.1.11",
    "next-themes": "^0.4.6",
    "p-queue": "^9.3.3",
    "puppeteer": "^25.12.0",
    "puppeteer-core": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hotkeys-hook": "^5.3.3",
    "react-resizable-panels": "^4.14.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@grain/eslint-plugin": "workspace:*",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/lunr": "^2.3.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-functional": "^10.0.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "sort-package-json": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "web-vitals": "^6.2.3"
  }
}
